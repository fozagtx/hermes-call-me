# Copy to .env for the standalone demo. Do not commit the filled-in file.
# Hermes itself reads the same names from its own env / secret store.

VAPI_API_KEY=
HERMES_CALL_ME_PIN=
HERMES_CALL_ME_WEBHOOK_SECRET=
HERMES_CALL_ME_WEBHOOK_URL=https://your-tunnel.example

# Real phone calls. US/CA use CALL-E local lines. Leave phone calls off for the browser demo.
CALLE_API_KEY=
CALLE_BASE_URL=https://api.heycall-e.com
HERMES_CALL_ME_PROVIDER=calle
HERMES_CALL_ME_REGION=US
HERMES_CALL_ME_LOCALE=en-US
HERMES_CALL_ME_OWNER_NUMBER=+1
HERMES_CALL_ME_PHONE_CALLS=0

# Optional. Only if HERMES_CALL_ME_PROVIDER=vapi and you place a Vapi phone call.
VAPI_PHONE_NUMBER_ID=

HERMES_CALL_ME_PORT=8787
HERMES_CALL_ME_TIMEOUT_SECONDS=180
HERMES_CALL_ME_DAILY_CAP=8
HERMES_CALL_ME_TIMEZONE=America/New_York
HERMES_CALL_ME_QUIET_HOURS=22:00-07:00
HERMES_CALL_ME_QUIET_HOURS_ENABLED=0
HERMES_CALL_ME_GUARD=0
HERMES_CALL_ME_CHANNEL=web
HERMES_CALL_ME_MODEL=gpt-4o-mini
