# Names for running outside Hermes (tests, python -m hermes_call_me).
# Inside Hermes, set these in the plugin's settings instead. Do not commit a filled-in copy.

CALLE_API_KEY=
HERMES_CALL_ME_PIN=
HERMES_CALL_ME_OWNER_NUMBER=+1
HERMES_CALL_ME_REGION=US
HERMES_CALL_ME_LOCALE=en-US

HERMES_CALL_ME_TIMEOUT_SECONDS=180
HERMES_CALL_ME_DAILY_CAP=8
HERMES_CALL_ME_TIMEZONE=America/New_York
HERMES_CALL_ME_QUIET_HOURS=22:00-07:00
HERMES_CALL_ME_QUIET_HOURS_ENABLED=0
HERMES_CALL_ME_GUARD=0
